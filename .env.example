# Copie para .env e ajuste.
# false = o site roda sozinho com dados de demonstração
# true  = chama o FastAPI de verdade
VITE_USE_API=false

# Em desenvolvimento deixe /api (o Vite encaminha para http://localhost:8000).
# Em produção use a URL completa do back-end, ex.: https://api.seudominio.com
VITE_API_URL=/api
